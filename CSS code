body {
    font-family: 'Arial', sans-serif;
    line-height: 1.6;
    background-color: #ffffff;
    color: #333;
    margin: 0;
    padding: 0;
}

header {
    background-color: #222;
    color: #fff;
    text-align: center;
    padding: 60px 0;
}

.header-content h1 {
    font-size: 2.5em;
    margin: 0;
}

.header-content p {
    font-size: 1.2em;
    margin-top: 10px;
}

nav {
    background-color: #444;
    position: sticky;
    top: 0;
    z-index: 100;
}

nav ul {
    list-style: none;
    display: flex;
    justify-content: center;
    padding: 0;
    margin: 0;
}

nav ul li {
    margin: 0;
}

nav ul li a {
    text-decoration: none;
    color: #fff;
    padding: 15px 20px;
    display: block;
    transition: background-color 0.3s ease;
}

nav ul li a:hover {
    background-color: #555;
}

main {
    padding: 20px;
    max-width: 1000px;
    margin: 0 auto;
}

section {
    margin-bottom: 40px;
}

h2 {
    font-size: 2em;
    color: #222;
    border-bottom: 2px solid #444;
    padding-bottom: 5px;
    margin-bottom: 20px;
}

.job, .education-item, .project {
    margin-bottom: 20px;
}

.skills-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
}

.skills-list li {
    background-color: #eee;
    margin: 5px;
    padding: 10px 15px;
    border-radius: 5px;
}

footer {
    background-color: #222;
    color: #fff;
    text-align: center;
    padding: 10px 0;
}

footer p {
    margin: 0;
} 
